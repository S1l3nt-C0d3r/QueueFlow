rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isGlobalAdmin() {
      return isAuthenticated() && request.auth.token.email == "incrediblegamer64@gmail.com" && request.auth.token.email_verified == true;
    }

    function isWaiter(restaurantId) {
      return isAuthenticated() && getUserData().role == 'waiter' && getUserData().restaurantId == restaurantId;
    }
    
    function isReceptionist(restaurantId) {
      return isAuthenticated() && getUserData().role == 'receptionist' && getUserData().restaurantId == restaurantId;
    }
    
    function isAdmin(restaurantId) {
      return isAuthenticated() && getUserData().role == 'admin' && getUserData().restaurantId == restaurantId;
    }

    // Restaurants
    match /restaurants/{restaurantId} {
      allow read: if true; // Customers need to see restaurant info
      allow create, update, delete: if isGlobalAdmin();
      
      // Queue
      match /queue/{entryId} {
        allow read: if true; 
        
        allow create: if request.resource.data.status == 'waiting' 
                      && request.resource.data.restaurantId == restaurantId;
        
        allow update: if (request.resource.data.status == 'cancelled' && resource.data.status == 'waiting')
                      || (request.resource.data.status == 'expired' && resource.data.status == 'notified')
                      || (isWaiter(restaurantId) && request.resource.data.status == 'notified')
                      || (isReceptionist(restaurantId) && (request.resource.data.status == 'seated' || request.resource.data.status == 'cancelled'))
                      || isAdmin(restaurantId)
                      || isGlobalAdmin();
                      
        allow delete: if isAdmin(restaurantId) || isGlobalAdmin();
      }

      // Menus - RESTRICTED: Only admin and global admin can write
      match /menus/{menuItemId} {
        allow read: if true;
        
        allow create, update: if isGlobalAdmin() || isAdmin(restaurantId);
        allow delete: if isGlobalAdmin() || isAdmin(restaurantId);
      }

      // Orders (preorders)
      match /orders/{orderId} {
        allow read: if isAuthenticated();
        
        allow create, update: if isAuthenticated();
        allow delete: if isGlobalAdmin() || isAdmin(restaurantId);
      }
    }

    // Users - RESTRICTED: Only own profile or global admin
    match /users/{userId} {
      allow read: if isOwner(userId) || isGlobalAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'restaurantId', 'uid']);
      allow delete: if isGlobalAdmin();
    }
  }
}
